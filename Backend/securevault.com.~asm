; SecureVault bridge backend for EMU8086.
; Build this file as a DOS .COM program named securevault.com.
;
; Usage from the bridge:
;   securevault.com request.txt response.txt
;
; The request file contains:
;   COMMAND\r\n
;   PASSWORD=hex bytes\r\n
;   DATA=hex bytes\r\n
;   CHECKSUM=4 hex digits\r\n
;
; The response file contains STATUS, DATA, and CHECKSUM lines.
; Status: 0 success, 1 invalid request, 2 authentication failure,
;         3 checksum failure, 4 malformed data, 5 file error.
;
; This is an educational reversible cipher, not production cryptography.

ORG 100h
JMP MAIN

REQUEST_SIZE EQU 4096
RESPONSE_SIZE EQU 4096
DATA_SIZE EQU 1024

request_path DB 128 DUP(0)
response_path DB 128 DUP(0)
master_path DB '../data\master.dat',0
default_request_path DB 'd:\request.txt',0
default_response_path DB 'd:\response.txt',0
request_buf DB REQUEST_SIZE DUP(0)
response_buf DB RESPONSE_SIZE DUP(0)
data_buf DB DATA_SIZE DUP(0)
password_buf DB 64 DUP(0)
request_length DW 0
response_length DW 0
data_length DW 0
password_length DW 0
stored_checksum DW 0
current_checksum DW 0
request_handle DW 0
response_handle DW 0

status_text DB 'STATUS=0',13,10
status_text_len EQU $-status_text
status_error DB 'STATUS=1',13,10
status_error_len EQU $-status_error
status_auth DB 'STATUS=2',13,10
status_auth_len EQU $-status_auth
status_check DB 'STATUS=3',13,10
status_check_len EQU $-status_check
status_data DB 'STATUS=4',13,10
status_data_len EQU $-status_data
status_file DB 'STATUS=5',13,10
status_file_len EQU $-status_file
data_label DB 'DATA='
data_label_len EQU $-data_label
checksum_label DB 'CHECKSUM='
checksum_label_len EQU $-checksum_label
crlf DB 13,10

password_field DB 'PASSWORD='
data_field DB 'DATA='
checksum_field DB 'CHECKSUM='
master_missing DB 0

MAIN:
MOV AX, CS
MOV DS, AX
MOV ES, AX

CALL PARSE_ARGUMENTS
JNC HAVE_ARGUMENTS
CALL USE_DEFAULT_ARGUMENTS
HAVE_ARGUMENTS:
CALL READ_REQUEST
JC EXIT_FILE_ERROR

CALL CLEAR_RESPONSE
CALL PARSE_PASSWORD
JC RESPONSE_INVALID

MOV AL, [request_buf]
CMP AL, 'S'
JE COMMAND_SETUP
CMP AL, 'V'
JE COMMAND_VERIFY
CMP AL, 'E'
JE COMMAND_ENCRYPT
CMP AL, 'D'
JE COMMAND_DECRYPT
CMP AL, 'C'
JE COMMAND_CHECK
JMP RESPONSE_INVALID

COMMAND_SETUP:
CALL PASSWORD_CHECKSUM
MOV stored_checksum, AX
CALL SAVE_MASTER
JC EXIT_FILE_ERROR
CALL WRITE_SUCCESS_RESPONSE
JMP EXIT_OK

COMMAND_VERIFY:
CALL PASSWORD_CHECKSUM
MOV current_checksum, AX
CALL LOAD_MASTER
JC EXIT_AUTH_ERROR
MOV AX, current_checksum
CMP AX, stored_checksum
JNE EXIT_AUTH_ERROR
CALL WRITE_SUCCESS_RESPONSE
JMP EXIT_OK

COMMAND_ENCRYPT:
CALL LOAD_DATA
JC RESPONSE_INVALID
CALL PASSWORD_CHECKSUM
CALL TRANSFORM_KEY
CALL ENCRYPT_BUFFER
CALL BUILD_DATA_RESPONSE
CALL WRITE_RESPONSE
JMP EXIT_OK

COMMAND_DECRYPT:
CALL LOAD_DATA
JC RESPONSE_INVALID
CALL PASSWORD_CHECKSUM
CALL VERIFY_DATA_CHECKSUM
JC EXIT_CHECK_ERROR
CALL TRANSFORM_KEY
CALL DECRYPT_BUFFER
CALL BUILD_DATA_RESPONSE
CALL WRITE_RESPONSE
JMP EXIT_OK

COMMAND_CHECK:
CALL LOAD_DATA
JC RESPONSE_INVALID
CALL VERIFY_DATA_CHECKSUM
JC EXIT_CHECK_ERROR
CALL WRITE_SUCCESS_RESPONSE
JMP EXIT_OK

RESPONSE_INVALID:
CALL WRITE_STATUS_DATA_ERROR
JMP EXIT_OK

EXIT_AUTH_ERROR:
CALL WRITE_STATUS_AUTH
JMP EXIT_OK

EXIT_CHECK_ERROR:
CALL WRITE_STATUS_CHECK
JMP EXIT_OK

EXIT_FILE_ERROR:
CALL WRITE_STATUS_FILE
JMP EXIT_OK

EXIT_OK:
MOV AX, 4C00h
INT 21h

; Parse PSP command tail into request_path and response_path.
PARSE_ARGUMENTS:
MOV SI, 81h
MOV CL, [80h]
XOR CH, CH
CMP CX, 1
JB PARSE_ARGUMENTS_FAIL
CALL SKIP_SPACES
LEA DI, request_path
CALL COPY_ARGUMENT
CALL SKIP_SPACES
LEA DI, response_path
CALL COPY_ARGUMENT
CMP BYTE PTR [request_path], 0
JE PARSE_ARGUMENTS_FAIL
CMP BYTE PTR [response_path], 0
JE PARSE_ARGUMENTS_FAIL
CLC
RET
PARSE_ARGUMENTS_FAIL:
STC
RET

USE_DEFAULT_ARGUMENTS:
LEA SI, default_request_path
LEA DI, request_path
CALL COPY_STRING
LEA SI, default_response_path
LEA DI, response_path
CALL COPY_STRING
RET

COPY_STRING:
MOV AL, [SI]
MOV [DI], AL
INC SI
INC DI
CMP AL, 0
JNE COPY_STRING
RET

SKIP_SPACES:
CMP CX, 0
JE SKIP_SPACES_DONE
CMP BYTE PTR [SI], ' '
JNE SKIP_SPACES_DONE
INC SI
DEC CX
JMP SKIP_SPACES
SKIP_SPACES_DONE:
RET

COPY_ARGUMENT:
CMP CX, 0
JE COPY_ARGUMENT_DONE
CMP BYTE PTR [SI], ' '
JE COPY_ARGUMENT_DONE
CMP BYTE PTR [SI], 13
JE COPY_ARGUMENT_DONE
MOV AL, [SI]
MOV [DI], AL
INC SI
INC DI
DEC CX
JMP COPY_ARGUMENT
COPY_ARGUMENT_DONE:
MOV BYTE PTR [DI], 0
RET

READ_REQUEST:
MOV DX, OFFSET request_path
MOV AX, 3D00h
INT 21h
JC READ_REQUEST_FAIL
MOV request_handle, AX
MOV BX, AX
MOV CX, REQUEST_SIZE-1
MOV DX, OFFSET request_buf
MOV AH, 3Fh
INT 21h
JC READ_REQUEST_CLOSE_FAIL
MOV request_length, AX
MOV AH, 3Eh
INT 21h
CLC
RET
READ_REQUEST_CLOSE_FAIL:
MOV AH, 3Eh
INT 21h
READ_REQUEST_FAIL:
STC
RET

CLEAR_RESPONSE:
MOV response_length, 0
RET

; Locate PASSWORD= and decode the following hex bytes.
PARSE_PASSWORD:
MOV SI, OFFSET request_buf
MOV CX, REQUEST_SIZE
LEA DI, password_field
MOV BX, 9
CALL FIND_FIELD
JC PARSE_PASSWORD_FAIL
MOV SI, DX
LEA DI, password_buf
CALL DECODE_HEX_LINE
JC PARSE_PASSWORD_FAIL
MOV password_length, BX
CLC
RET
PARSE_PASSWORD_FAIL:
STC
RET

; Locate DATA= and decode the following hex bytes.
LOAD_DATA:
MOV SI, OFFSET request_buf
MOV CX, REQUEST_SIZE
LEA DI, data_field
MOV BX, 5
CALL FIND_FIELD
JC LOAD_DATA_FAIL
MOV SI, DX
LEA DI, data_buf
CALL DECODE_HEX_LINE
JC LOAD_DATA_FAIL
MOV data_length, BX
CLC
RET
LOAD_DATA_FAIL:
STC
RET

; Find a field and return DX at its value.
FIND_FIELD:
PUSH AX
PUSH BX
PUSH CX
PUSH SI
FIND_FIELD_NEXT:
CMP CX, 0
JE FIND_FIELD_NOT_FOUND
MOV AL, [SI]
CMP AL, [DI]
JNE FIND_FIELD_ADVANCE
PUSH SI
PUSH DI
PUSH CX
MOV CX, BX
REPE CMPSB
POP CX
POP DI
POP SI
JE FIND_FIELD_FOUND
FIND_FIELD_ADVANCE:
INC SI
DEC CX
JMP FIND_FIELD_NEXT
FIND_FIELD_FOUND:
MOV DX, SI
ADD DX, BX
POP SI
POP CX
POP BX
POP AX
CLC
RET
FIND_FIELD_NOT_FOUND:
POP SI
POP CX
POP BX
POP AX
STC
RET

; Decode uppercase/lowercase hexadecimal until CR/LF.
; DS:SI source, DS:DI destination, returns BX byte count.
DECODE_HEX_LINE:
XOR BX, BX
DECODE_NEXT:
MOV AL, [SI]
CMP AL, 13
JE DECODE_DONE
CMP AL, 10
JE DECODE_DONE
CMP AL, 0
JE DECODE_DONE
CALL HEX_VALUE
JC DECODE_FAIL
MOV DL, AL
INC SI
MOV AL, [SI]
CALL HEX_VALUE
JC DECODE_FAIL
MOV DH, AL
SHL DL, 1
SHL DL, 1
SHL DL, 1
SHL DL, 1
OR DL, DH
MOV [DI], DL
INC DI
INC SI
INC BX
CMP BX, DATA_SIZE
JAE DECODE_FAIL
JMP DECODE_NEXT
DECODE_DONE:
CLC
RET
DECODE_FAIL:
STC
RET

HEX_VALUE:
CMP AL, '0'
JB HEX_FAIL
CMP AL, '9'
JBE HEX_DIGIT
AND AL, 0DFh
CMP AL, 'A'
JB HEX_FAIL
CMP AL, 'F'
JA HEX_FAIL
SUB AL, 'A'-10
CLC
RET
HEX_DIGIT:
SUB AL, '0'
CLC
RET
HEX_FAIL:
STC
RET

PASSWORD_CHECKSUM:
MOV SI, OFFSET password_buf
MOV CX, password_length
CALL GENERATE_CHECKSUM
RET

TRANSFORM_KEY:
MOV DL, AL
MOV DH, AH
RET

ENCRYPT_BUFFER:
MOV SI, OFFSET data_buf
MOV CX, data_length
ENCRYPT_NEXT:
CMP CX, 0
JE ENCRYPT_DONE
MOV AL, [SI]
XOR AL, DL
ADD AL, DH
ROL AL, 1
MOV [SI], AL
ADD DL, 17
XOR DH, 0A5h
INC SI
DEC CX
JMP ENCRYPT_NEXT
ENCRYPT_DONE:
RET

DECRYPT_BUFFER:
MOV SI, OFFSET data_buf
MOV CX, data_length
DECRYPT_NEXT:
CMP CX, 0
JE DECRYPT_DONE
MOV AL, [SI]
ROR AL, 1
SUB AL, DH
XOR AL, DL
MOV [SI], AL
ADD DL, 17
XOR DH, 0A5h
INC SI
DEC CX
JMP DECRYPT_NEXT
DECRYPT_DONE:
RET

GENERATE_CHECKSUM:
XOR AX, AX
CHECKSUM_NEXT:
CMP CX, 0
JE CHECKSUM_DONE
XOR BX, BX
MOV BL, [SI]
ADD AX, BX
ROL AX, 1
INC SI
DEC CX
JMP CHECKSUM_NEXT
CHECKSUM_DONE:
RET

VERIFY_DATA_CHECKSUM:
MOV SI, OFFSET data_buf
MOV CX, data_length
CALL GENERATE_CHECKSUM
MOV current_checksum, AX
MOV SI, OFFSET request_buf
MOV CX, REQUEST_SIZE
LEA DI, checksum_field
MOV BX, 9
CALL FIND_FIELD
JC VERIFY_DATA_FAIL
MOV SI, DX
CALL READ_HEX_WORD
CMP AX, current_checksum
JNE VERIFY_DATA_FAIL
CLC
RET
VERIFY_DATA_FAIL:
STC
RET

READ_HEX_WORD:
XOR BX, BX
MOV CX, 4
READ_HEX_WORD_NEXT:
SHL BX, 1
SHL BX, 1
SHL BX, 1
SHL BX, 1
MOV AL, [SI]
CALL HEX_VALUE
JC READ_HEX_WORD_FAIL
XOR AH, AH
OR BL, AL
INC SI
LOOP READ_HEX_WORD_NEXT
MOV AX, BX
CLC
RET
READ_HEX_WORD_FAIL:
XOR AX, AX
STC
RET

SAVE_MASTER:
MOV DX, OFFSET master_path
MOV CX, 0
MOV AH, 3Ch
INT 21h
JC SAVE_MASTER_FAIL
MOV BX, AX
MOV AX, stored_checksum
MOV DX, OFFSET stored_checksum
MOV CX, 2
MOV AH, 40h
INT 21h
JC SAVE_MASTER_CLOSE_FAIL
MOV AH, 3Eh
INT 21h
CLC
RET
SAVE_MASTER_CLOSE_FAIL:
MOV AH, 3Eh
INT 21h
SAVE_MASTER_FAIL:
STC
RET

LOAD_MASTER:
MOV DX, OFFSET master_path
MOV AX, 3D00h
INT 21h
JC LOAD_MASTER_FAIL
MOV BX, AX
MOV CX, 2
MOV DX, OFFSET stored_checksum
MOV AH, 3Fh
INT 21h
JC LOAD_MASTER_CLOSE_FAIL
CMP AX, 2
JNE LOAD_MASTER_CLOSE_FAIL
MOV AH, 3Eh
INT 21h
CLC
RET
LOAD_MASTER_CLOSE_FAIL:
MOV AH, 3Eh
INT 21h
LOAD_MASTER_FAIL:
STC
RET

WRITE_SUCCESS_RESPONSE:
MOV SI, OFFSET status_text
MOV CX, status_text_len
CALL APPEND_BYTES
JMP WRITE_RESPONSE

WRITE_STATUS_AUTH:
MOV SI, OFFSET status_auth
MOV CX, status_auth_len
CALL APPEND_BYTES
JMP WRITE_RESPONSE

WRITE_STATUS_CHECK:
MOV SI, OFFSET status_check
MOV CX, status_check_len
CALL APPEND_BYTES
JMP WRITE_RESPONSE

WRITE_STATUS_DATA_ERROR:
MOV SI, OFFSET status_data
MOV CX, status_data_len
CALL APPEND_BYTES
JMP WRITE_RESPONSE

WRITE_STATUS_FILE:
MOV SI, OFFSET status_file
MOV CX, status_file_len
CALL APPEND_BYTES

WRITE_RESPONSE:
MOV DX, OFFSET response_path
MOV CX, 0
MOV AH, 3Ch
INT 21h
JC WRITE_RESPONSE_FAIL
MOV response_handle, AX
MOV BX, AX
MOV CX, response_length
MOV DX, OFFSET response_buf
MOV AH, 40h
INT 21h
JC WRITE_RESPONSE_CLOSE
MOV AH, 3Eh
INT 21h
RET
WRITE_RESPONSE_CLOSE:
MOV AH, 3Eh
INT 21h
WRITE_RESPONSE_FAIL:
RET

BUILD_DATA_RESPONSE:
MOV response_length, 0
MOV SI, OFFSET status_text
MOV CX, status_text_len
CALL APPEND_BYTES
MOV SI, OFFSET data_label
MOV CX, data_label_len
CALL APPEND_BYTES
MOV SI, OFFSET data_buf
MOV CX, data_length
BUILD_DATA_NEXT:
CMP CX, 0
JE BUILD_DATA_DONE
MOV AL, [SI]
CALL APPEND_HEX_BYTE
INC SI
DEC CX
JMP BUILD_DATA_NEXT
BUILD_DATA_DONE:
MOV SI, OFFSET crlf
MOV CX, 2
CALL APPEND_BYTES
MOV SI, OFFSET checksum_label
MOV CX, checksum_label_len
CALL APPEND_BYTES
MOV SI, OFFSET data_buf
MOV CX, data_length
CALL GENERATE_CHECKSUM
CALL APPEND_HEX_WORD
MOV SI, OFFSET crlf
MOV CX, 2
CALL APPEND_BYTES
RET

APPEND_BYTES:
PUSH AX
PUSH BX
PUSH SI
MOV DI, OFFSET response_buf
ADD DI, response_length
REP MOVSB
MOV AX, DI
SUB AX, OFFSET response_buf
MOV response_length, AX
POP SI
POP BX
POP AX
RET

APPEND_HEX_BYTE:
PUSH AX
MOV AH, AL
AND AL, 0F0h
MOV CL, 4
SHR AL, CL
CALL NIBBLE_ASCII
MOV DI, OFFSET response_buf
ADD DI, response_length
MOV [DI], AL
INC response_length
MOV AL, AH
AND AL, 0Fh
CALL NIBBLE_ASCII
MOV DI, OFFSET response_buf
ADD DI, response_length
MOV [DI], AL
INC response_length
POP AX
RET

APPEND_HEX_WORD:
PUSH AX
MOV AL, AH
CALL APPEND_HEX_BYTE
POP AX
CALL APPEND_HEX_BYTE
RET

NIBBLE_ASCII:
CMP AL, 9
JBE NIBBLE_DIGIT
ADD AL, 'A'-10
RET
NIBBLE_DIGIT:
ADD AL, '0'
RET

END_PROGRAM:
JMP EXIT_OK




