[ 255]        :                                       ; ============================================================
[ 256]        :                                       ; COMPARE_PASSWORDS
[ 257]        :                                       ;
[ 258]        :                                       ; Input:
[ 259]        :                                       ;   DS:SI -> first password buffer
[ 260]        :                                       ;   DS:DI -> second password buffer
[ 261]        :                                       ;
[ 262]        :                                       ; Output:
[ 263]        :                                       ;   AL = 1  -> match
[ 264]        :                                       ;   AL = 0  -> mismatch
[ 265]        :                                       ; ============================================================
[ 266]        :                                       
[ 267]    0387:                                       COMPARE_PASSWORDS PROC
[ 268]        :                                       
[ 269]    0387: 53                                    PUSH BX
[ 270]    0388: 51                                    PUSH CX
[ 271]    0389: 52                                    PUSH DX
[ 272]    038A: 56                                    PUSH SI
[ 273]    038B: 57                                    PUSH DI
[ 274]        :                                       
[ 275]        :                                       ; Get first password length
[ 276]        :                                       
[ 277]    038C: 8A 5C 01                              MOV BL, [SI + 1]
[ 278]        :                                       
[ 279]        :                                       ; Get second password length
[ 280]        :                                       
[ 281]    038F: 8A 7D 01                              MOV BH, [DI + 1]
[ 282]        :                                       
[ 283]        :                                       ; Compare lengths
[ 284]        :                                       
[ 285]    0392: 3A DF                                 CMP BL, BH
[ 286]    0394: 75 1F                                 JNE PASSWORDS_DIFFERENT
[ 287]        :                                       
[ 288]        :                                       ; Number of characters
[ 289]        :                                       
[ 290]    0396: 8A CB                                 MOV CL, BL
[ 291]    0398: B5 00                                 MOV CH, 0
[ 292]        :                                       
[ 293]        :                                       ; Move to actual character data
[ 294]        :                                       
[ 295]    039A: 83 C6 02                              ADD SI, 2
[ 296]    039D: 83 C7 02                              ADD DI, 2
[ 297]        :                                       
[ 298]        :                                       ; Empty password
[ 299]        :                                       
[ 300]    03A0: 83 F9 00                              CMP CX, 0
[ 301]    03A3: 74 0C                                 JE PASSWORDS_EQUAL
[ 302]        :                                       
[ 303]    03A5:                                       COMPARE_LOOP:
[ 304]        :                                       
[ 305]    03A5: 8A 04                                 MOV AL, [SI]
[ 306]    03A7: 8A 15                                 MOV DL, [DI]
[ 307]        :                                       
[ 308]    03A9: 3A C2                                 CMP AL, DL
[ 309]    03AB: 75 08                                 JNE PASSWORDS_DIFFERENT
[ 310]        :                                       
[ 311]    03AD: 46                                    INC SI
[ 312]    03AE: 47                                    INC DI
[ 313]        :                                       
[ 314]    03AF: E2 F4                                 LOOP COMPARE_LOOP
[ 315]        :                                       
[ 316]        :                                       
[ 317]    03B1:                                       PASSWORDS_EQUAL:
[ 318]        :                                       
[ 319]    03B1: B0 01                                 MOV AL, 1
[ 320]    03B3: EB 02                                 JMP COMPARE_DONE
[ 321]        :                                       
[ 322]        :                                       
[ 323]    03B5:                                       PASSWORDS_DIFFERENT:
[ 324]        :                                       
[ 325]    03B5: B0 00                                 MOV AL, 0
[ 326]        :                                       
[ 327]        :                                       
[ 328]    03B7:                                       COMPARE_DONE:
[ 329]        :                                       
[ 330]    03B7: 5F                                    POP DI
[ 331]    03B8: 5E                                    POP SI
[ 332]    03B9: 5A                                    POP DX
[ 333]    03BA: 59                                    POP CX
[ 334]    03BB: 5B                                    POP BX
[ 335]        :                                       
[ 336]    03BC: C3                                    RET
[ 337]        :                                       
[ 338]        :                                       COMPARE_PASSWORDS ENDP
[ 339]        :                                       
[ 340]        :                                       
[ 341]        :                                       ; ============================================================
[ 342]        :                                       ; GENERATE_CHECKSUM
[ 343]        :                                       ;
[ 344]        :                                       ; Input:
[ 345]        :                                       ;   DS:SI -> password buffer
[ 346]        :                                       ;
[ 347]        :                                       ; Output:
[ 348]        :                                       ;   AX -> 16-bit checksum
[ 349]        :                                       ;
[ 350]        :                                       ; Educational checksum:
[ 351]        :                                       ;
[ 352]        :                                       ;   checksum = checksum + ASCII(character)
[ 353]        :                                       ;
[ 354]        :                                       ;   then rotate left by 1 bit.
[ 355]        :                                       ;
[ 356]        :                                       ; This is NOT cryptographically secure hashing.
[ 357]        :                                       ; It is an Assembly demonstration for the project.
[ 358]        :                                       ; ============================================================
[ 359]        :                                       
[ 360]    03BD:                                       GENERATE_CHECKSUM PROC
[ 361]        :                                       
[ 362]    03BD: 53                                    PUSH BX
[ 363]    03BE: 51                                    PUSH CX
[ 364]    03BF: 52                                    PUSH DX
[ 365]    03C0: 56                                    PUSH SI
[ 366]        :                                       
[ 367]    03C1: 33 C0                                 XOR AX, AX
[ 368]        :                                       
[ 369]        :                                       ; Password length
[ 370]        :                                       
[ 371]    03C3: 8A 4C 01                              MOV CL, [SI + 1]
[ 372]    03C6: B5 00                                 MOV CH, 0
[ 373]        :                                       
[ 374]        :                                       ; Move to password characters
[ 375]        :                                       
[ 376]    03C8: 83 C6 02                              ADD SI, 2
[ 377]        :                                       
[ 378]    03CB: 83 F9 00                              CMP CX, 0
[ 379]    03CE: 74 0B                                 JE CHECKSUM_DONE
[ 380]        :                                       
[ 381]        :                                       
[ 382]    03D0:                                       CHECKSUM_LOOP:
[ 383]        :                                       
[ 384]        :                                       ; Get character
[ 385]        :                                       
[ 386]    03D0: 32 FF                                 XOR BH, BH
[ 387]    03D2: 8A 1C                                 MOV BL, [SI]
[ 388]        :                                       
[ 389]        :                                       ; Add ASCII value
[ 390]        :                                       
[ 391]    03D4: 03 C3                                 ADD AX, BX
[ 392]        :                                       
[ 393]        :                                       ; Rotate checksum left
[ 394]        :                                       
[ 395]    03D6: D1 C0                                 ROL AX, 1
[ 396]        :                                       
[ 397]    03D8: 46                                    INC SI
[ 398]        :                                       
[ 399]    03D9: E2 F5                                 LOOP CHECKSUM_LOOP
[ 400]        :                                       
[ 401]        :                                       
[ 402]    03DB:                                       CHECKSUM_DONE:
[ 403]        :                                       
[ 404]    03DB: 5E                                    POP SI
[ 405]    03DC: 5A                                    POP DX
[ 406]    03DD: 59                                    POP CX
[ 407]    03DE: 5B                                    POP BX
[ 408]        :                                       
[ 409]    03DF: C3                                    RET
[ 410]        :                                       
[ 411]        :                                       GENERATE_CHECKSUM ENDP
[ 412]        :                                       
